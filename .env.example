# Copy to .env and adjust; docker compose reads it automatically.

# Public name of the server. A real domain whose DNS points here gets a Let's Encrypt certificate
# (ports 80 and 443 must be reachable from the internet). localhost, an IP address or a LAN-only
# name gets a certificate from Caddy's own local CA instead.
DOMAIN=localhost

# Optional `tls` directive for Caddy (see deploy/Caddyfile), e.g.
#   CADDY_TLS=tls you@example.com
#   CADDY_TLS=tls /certs/fullchain.pem /certs/privkey.pem
CADDY_TLS=

# Host ports Caddy listens on.
HTTP_PORT=80
HTTPS_PORT=443

# Default model variant (see `wan-video models list`), and extra `wan-video serve` flags.
WAN_VIDEO_VARIANT=vace-1.3b
WAN_VIDEO_SERVE_ARGS=
# e.g. WAN_VIDEO_SERVE_ARGS=--preload --offload model

# Optional Hugging Face token for faster, rate-limit-free downloads.
HF_TOKEN=
