# The app has no login of its own. To require a password, copy this file to auth.caddy
# (in this folder) and restart Caddy: docker compose restart caddy
#
# Make the password hash with:
#   docker compose run --rm caddy caddy hash-password --plaintext 'your password'

basic_auth {
	admin $2a$14$REPLACE_WITH_THE_HASH_FROM_caddy_hash-password
}
