# HTTPS front end for poly-wan (see docker-compose.yml and .env.example).
#
# DOMAIN    a public name gets a Let's Encrypt certificate automatically; localhost, an IP address
#           or a LAN-only name gets one from Caddy's local CA (browsers warn until it is trusted).
# CADDY_TLS optional extra `tls` directive, e.g.
#             tls you@example.com                          contact address for Let's Encrypt
#             tls internal                                 force the local CA
#             tls /certs/fullchain.pem /certs/privkey.pem  your own certificate (put it in deploy/certs)

{$DOMAIN:localhost} {
	{$CADDY_TLS}

	# Optional extras such as basic auth: any deploy/conf.d/*.caddy file is included here.
	import /etc/caddy/conf.d/*.caddy

	encode zstd gzip

	reverse_proxy app:7860 {
		# Jobs can be awaited with wait=true and take minutes; never cut them off.
		transport http {
			read_timeout 0
			write_timeout 0
		}
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
		-Server
	}
}
